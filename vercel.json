{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-learning.mjs && node scripts/build-chess.mjs && node scripts/build-chess-play.mjs && npm run docs && npm run check",
  "installCommand": "echo Frontend and challenge functions use no external packages",
  "outputDirectory": "dist",
  "functions": {
    "api/challenge-*.js": {"maxDuration": 15}
  },
  "headers": [
    {"source":"/live-config.json","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/learning-config.json","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/chess/chess-config.json","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/play/play-config.json","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/play/replay/bundles/:bundle/experiments/chess/lib/selector.mjs","headers":[{"key":"Content-Type","value":"text/javascript; charset=utf-8"}]},
    {"source":"/play/replay/bundles/:bundle/experiments/chess-play/verification/verify.mjs","headers":[{"key":"Content-Type","value":"text/javascript; charset=utf-8"}]},
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), display-capture=(), geolocation=()"}]}
  ]
}
