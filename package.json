{
  "name": "zebrafish-neural",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Zebrafish Neural: a shared browser controller and controlled visual-motor experiments.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "docs": "node scripts/build-docs.mjs",
    "test:chess": "node --test experiments/chess/tests/*.test.mjs",
    "chess": "node experiments/chess/server.mjs",
    "chess:relay": "node experiments/chess/relay.mjs",
    "runtime": "node runtime/server.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "sharp": "0.35.4",
    "ws": "8.21.3"
  }
}
